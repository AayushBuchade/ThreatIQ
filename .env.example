# ==============================================================================
# ThreatIQ Platform Configuration Environment Template
# Copy this file to .env and configure secrets prior to deployment.
# ==============================================================================

# Core Application Settings
PROJECT_NAME=ThreatIQ
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL for Docker/Production, SQLite for Zero-dependency Local Dev)
DATABASE_URL=sqlite+aiosqlite:///./threatiq.db
SYNC_DATABASE_URL=sqlite:///./threatiq.db
# For PostgreSQL container:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/threatiq
# SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/threatiq

# Redis Event Bus & Cache
REDIS_URL=redis://localhost:6379/0

# Security & CORS
SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]

# Safety Policy: Zero Destructive Actions
ALLOW_DESTRUCTIVE_ACTIONS=false

